{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "qtagger/demo/0.1.0/global.schema.json",
  "x-schema-version": "0.1.0",
  "$defs": {
    "Architecture": {
      "additionalProperties": false,
      "description": "Configuration, layers and parameters of the model.",
      "properties": {
        "config": {
          "additionalProperties": true,
          "title": "Config",
          "type": "object"
        },
        "layers": {
          "items": {
            "$ref": "#/$defs/LayerDescription"
          },
          "title": "Layers",
          "type": "array"
        },
        "parameters": {
          "title": "Parameters",
          "type": "integer"
        }
      },
      "required": [
        "config",
        "layers",
        "parameters"
      ],
      "title": "Architecture",
      "type": "object"
    },
    "BaselineRow": {
      "additionalProperties": false,
      "description": "A model of the baseline ladder (cross-validation, never test).",
      "properties": {
        "rung": {
          "title": "Rung",
          "type": "string"
        },
        "classifier": {
          "title": "Classifier",
          "type": "string"
        },
        "target": {
          "title": "Target",
          "type": "string"
        },
        "cv_f1_macro": {
          "title": "Cv F1 Macro",
          "type": "number"
        },
        "cv_f1_macro_std": {
          "title": "Cv F1 Macro Std",
          "type": "number"
        },
        "oof_f1_macro": {
          "title": "Oof F1 Macro",
          "type": "number"
        },
        "oof_f1_macro_ci": {
          "items": {
            "type": "number"
          },
          "title": "Oof F1 Macro Ci",
          "type": "array"
        }
      },
      "required": [
        "rung",
        "classifier",
        "target",
        "cv_f1_macro",
        "cv_f1_macro_std",
        "oof_f1_macro",
        "oof_f1_macro_ci"
      ],
      "title": "BaselineRow",
      "type": "object"
    },
    "ClassInfo": {
      "additionalProperties": false,
      "description": "A label of the dataset.",
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "family": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Family"
        },
        "status": {
          "enum": [
            "trainable",
            "family_only",
            "reserved",
            "unknown_without_family"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "name",
        "family",
        "status"
      ],
      "title": "ClassInfo",
      "type": "object"
    },
    "ConfusionMatrix": {
      "additionalProperties": false,
      "description": "Rows = true class, columns = predicted class.",
      "properties": {
        "labels": {
          "items": {
            "type": "string"
          },
          "title": "Labels",
          "type": "array"
        },
        "matrix": {
          "items": {
            "items": {
              "type": "integer"
            },
            "type": "array"
          },
          "title": "Matrix",
          "type": "array"
        }
      },
      "required": [
        "labels",
        "matrix"
      ],
      "title": "ConfusionMatrix",
      "type": "object"
    },
    "Confusions": {
      "additionalProperties": false,
      "description": "Confusion matrices of both heads.",
      "properties": {
        "source": {
          "title": "Source",
          "type": "string"
        },
        "algorithm": {
          "$ref": "#/$defs/ConfusionMatrix"
        },
        "family": {
          "$ref": "#/$defs/ConfusionMatrix"
        }
      },
      "required": [
        "source",
        "algorithm",
        "family"
      ],
      "title": "Confusions",
      "type": "object"
    },
    "DatasetStats": {
      "additionalProperties": false,
      "description": "Counts of the usable canonical circuits.",
      "properties": {
        "version": {
          "title": "Version",
          "type": "string"
        },
        "circuits": {
          "title": "Circuits",
          "type": "integer"
        },
        "groups": {
          "title": "Groups",
          "type": "integer"
        },
        "by_level": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "By Level",
          "type": "object"
        },
        "by_family": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "By Family",
          "type": "object"
        },
        "by_class": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "By Class",
          "type": "object"
        },
        "qubits": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Qubits",
          "type": "object"
        },
        "gates": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Gates",
          "type": "object"
        }
      },
      "required": [
        "version",
        "circuits",
        "groups",
        "by_level",
        "by_family",
        "by_class",
        "qubits",
        "gates"
      ],
      "title": "DatasetStats",
      "type": "object"
    },
    "Decision": {
      "additionalProperties": false,
      "description": "A row of the decision log (docs/DECISIONES.md).",
      "properties": {
        "date": {
          "title": "Date",
          "type": "string"
        },
        "phase": {
          "title": "Phase",
          "type": "string"
        },
        "decision": {
          "title": "Decision",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "alternative": {
          "title": "Alternative",
          "type": "string"
        }
      },
      "required": [
        "date",
        "phase",
        "decision",
        "reason",
        "alternative"
      ],
      "title": "Decision",
      "type": "object"
    },
    "FamilyInfo": {
      "additionalProperties": false,
      "description": "A family and its algorithms.",
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "classes": {
          "items": {
            "type": "string"
          },
          "title": "Classes",
          "type": "array"
        },
        "algorithms": {
          "items": {
            "type": "string"
          },
          "title": "Algorithms",
          "type": "array"
        }
      },
      "required": [
        "name",
        "classes",
        "algorithms"
      ],
      "title": "FamilyInfo",
      "type": "object"
    },
    "GalleryEntry": {
      "additionalProperties": false,
      "description": "A circuit file of the export.",
      "properties": {
        "slug": {
          "title": "Slug",
          "type": "string"
        },
        "role": {
          "enum": [
            "main",
            "family",
            "error",
            "unknown"
          ],
          "title": "Role",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "algorithm": {
          "title": "Algorithm",
          "type": "string"
        },
        "family": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Family"
        }
      },
      "required": [
        "slug",
        "role",
        "path",
        "algorithm",
        "family"
      ],
      "title": "GalleryEntry",
      "type": "object"
    },
    "LayerDescription": {
      "additionalProperties": false,
      "description": "One layer of the model (``CircuitGNN.describe``).",
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "type": {
          "title": "Type",
          "type": "string"
        },
        "inputs": {
          "title": "Inputs",
          "type": "integer"
        },
        "outputs": {
          "title": "Outputs",
          "type": "integer"
        },
        "parameters": {
          "title": "Parameters",
          "type": "integer"
        }
      },
      "required": [
        "name",
        "type",
        "inputs",
        "outputs",
        "parameters"
      ],
      "title": "LayerDescription",
      "type": "object"
    },
    "MachineMeasurement": {
      "additionalProperties": false,
      "description": "Speed of a machine (results/medicion).",
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "device": {
          "title": "Device",
          "type": "string"
        },
        "mixed_precision": {
          "title": "Mixed Precision",
          "type": "boolean"
        },
        "seconds_per_epoch": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Seconds Per Epoch"
        },
        "hours_per_epoch": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Hours Per Epoch"
        }
      },
      "required": [
        "name",
        "device",
        "mixed_precision",
        "seconds_per_epoch",
        "hours_per_epoch"
      ],
      "title": "MachineMeasurement",
      "type": "object"
    },
    "MapPoint": {
      "additionalProperties": false,
      "description": "A circuit in the 2D reference map.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "x": {
          "title": "X",
          "type": "number"
        },
        "y": {
          "title": "Y",
          "type": "number"
        },
        "class_label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Class Label"
        },
        "family": {
          "title": "Family",
          "type": "string"
        },
        "predicted": {
          "title": "Predicted",
          "type": "string"
        }
