      "title": "MapPoint",
      "type": "object"
    },
    "ModelInfo": {
      "additionalProperties": false,
      "description": "The model that produced the traces, predictions and explanations.",
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "fingerprint": {
          "description": "Fingerprint of the training run (run_identity).",
          "title": "Fingerprint",
          "type": "string"
        },
        "training_code": {
          "description": "Version of the training code (source hash).",
          "title": "Training Code",
          "type": "string"
        },
        "cv_block": {
          "description": "Cross-validation block held out when training.",
          "title": "Cv Block",
          "type": "integer"
        },
        "device": {
          "title": "Device",
          "type": "string"
        },
        "precision": {
          "title": "Precision",
          "type": "string"
        },
        "epochs": {
          "title": "Epochs",
          "type": "integer"
        },
        "f1_macro_algorithm": {
          "description": "Macro F1 on the held-out block.",
          "title": "F1 Macro Algorithm",
          "type": "number"
        },
        "f1_macro_family": {
          "title": "F1 Macro Family",
          "type": "number"
        },
        "architecture": {
          "$ref": "#/$defs/Architecture"
        },
        "node_features": {
          "items": {
            "type": "string"
          },
          "title": "Node Features",
          "type": "array"
        },
        "edge_features": {
          "description": "Edge attributes the model reads.",
          "items": {
            "type": "string"
          },
          "title": "Edge Features",
          "type": "array"
        }
      },
      "required": [
        "name",
        "description",
        "fingerprint",
        "training_code",
        "cv_block",
        "device",
        "precision",
        "epochs",
        "f1_macro_algorithm",
        "f1_macro_family",
        "architecture",
        "node_features",
        "edge_features"
      ],
      "title": "ModelInfo",
      "type": "object"
    },
    "ReferenceMap": {
      "additionalProperties": false,
      "description": "2D projection of the summary vectors of known circuits.",
      "properties": {
        "method": {
          "title": "Method",
          "type": "string"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "explained_variance": {
          "items": {
            "type": "number"
          },
          "title": "Explained Variance",
          "type": "array"
        },
        "points": {
          "items": {
            "$ref": "#/$defs/MapPoint"
          },
          "title": "Points",
          "type": "array"
        }
      },
      "required": [
        "method",
        "source",
        "explained_variance",
        "points"
      ],
      "title": "ReferenceMap",
      "type": "object"
    },
