# Generated dataset: everything under the top-level data/ except its README.
# Patterns are anchored with a leading slash so that src/qcclass/data/ is NOT ignored.
/data/*
!/data/README.md
!/data/VERSION.json

# Experiment outputs and reports (performance measurements are versioned)
/results/*
!/results/medicion/
!/results/baseline/
/results/baseline/estudios/
/results/baseline/cache/

# QTaggerDemo exports (qcclass exportar-demo; regenerated from results/)
/exports/

# Reduced dataset (configs/dataset_mini.yaml)
/data_mini/
/results_mini/

# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Virtual environment
.venv/

# Tooling caches
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/

# OS
.DS_Store

# Dataset archives for other machines (qcclass medir)
*.tgz

# Per-machine settings (servers, machine name): see docs/EQUIPOS.md
.env

# Logs of long jobs launched with tmux (docs/EQUIPOS.md)
/logs/
