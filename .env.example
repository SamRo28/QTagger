# Per-machine settings: copy to .env (never committed) and adapt. See docs/EQUIPOS.md.

# Every machine
QCCLASS_EQUIPO=m3pro
QCCLASS_MLFLOW_URI=http://192.168.1.133:5050
QCCLASS_OPTUNA_STORAGE=grpc://192.168.1.133:13000

# Optional (defaults shown)
# QCCLASS_PROCESOS_CARGA=4              # GNN data-loading processes
# QCCLASS_REINTENTO_ESPERA_INICIAL=1    # first wait after a server cut (s)
# QCCLASS_REINTENTO_ESPERA_MAXIMA=60    # longest wait between attempts (s)
# QCCLASS_REINTENTO_TOTAL=600           # total retry time before failing (s)

# Only the server machine (m1pro)
# QCCLASS_SERVIDORES_DIR=/Users/samuel/qcclass_servidores
# QCCLASS_SERVIDORES_HOST=0.0.0.0
# QCCLASS_MLFLOW_PUERTO=5050
# QCCLASS_OPTUNA_PUERTO=13000
